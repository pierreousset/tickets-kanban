{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --include schema.graphql src/server.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test test/tickets.test.ts"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "fastify": "5",
    "graphql": "16",
    "graphql-scalars": "^2.0.1",
    "mercurius": "16",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}